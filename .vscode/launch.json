{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "build bin and debug in devcontainer",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/main.go",
            "args": ["-env", "self"]
        },
        {
            "name": "debug in debug mode docker",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "remotePath": "/app",
            "port": 1234,
            "host": "127.0.0.1",
            "showLog": true,
            "trace": "verbose",
            "apiVersion": 2,
            "dlvLoadConfig": {
                "followPointers": true,
                "maxVariableRecurse": 1,
                "maxStringLen": 64,
                "maxArrayValues": 64,
                "maxStructFields": -1
            }
        }
    ]
}